{
  admin off
  auto_https off
}

(backend) {
  reverse_proxy {$UPSTREAM_HOST}:8317 {
    header_up Authorization "Bearer {$UPSTREAM_API_KEY}"
    header_up -X-Api-Key
    header_up -X-Goog-Api-Key
    header_up -X-Management-Key
    flush_interval -1
  }
}

(inference) {
  handle @authorized {
    import backend
  }
  handle @anthropic {
    import backend
  }
  respond "Unauthorized" 401
}

# Health port has no public domain attached.
:8081 {
  respond /healthz "ok" 200
  respond 404
}

:8080 {
  header -Server
  request_body {
    max_size 32MB
  }
  @read {
    method GET
    path /v1/models /v1/responses /v1/realtime
  }
  @voiceSideband {
    method GET
    path_regexp voiceSideband ^/v1/live/[A-Za-z0-9_-]+$
  }
  @write {
    method POST
    path /v1/chat/completions /v1/completions /v1/messages /v1/messages/count_tokens /v1/responses /v1/responses/compact /v1/live
  }
  @authorized {
    header Authorization "Bearer {$PROXY_API_KEY}"
  }
  @anthropic {
    header X-Api-Key "{$PROXY_API_KEY}"
  }
  route {
    handle @read {
      import inference
    }
    handle @write {
      import inference
    }
    handle @voiceSideband {
      import inference
    }
    respond 404
  }
}
